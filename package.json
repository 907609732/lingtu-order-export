{
  "name": "lingtu-order-export",
  "version": "0.1.21",
  "description": "电商平台采购订单导出",
  "author": "Local Order Desk",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config build/config/electron.vite.config.ts",
    "build": "vue-tsc --noEmit && electron-vite build --config build/config/electron.vite.config.ts",
    "start": "electron-vite preview --config build/config/electron.vite.config.ts",
    "test": "vitest run --config build/config/vitest.config.ts",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "electron-log": "5.4.4",
    "element-plus": "2.14.7",
    "exceljs": "4.4.0",
    "http-mitm-proxy": "^1.1.0",
    "json-bigint": "^1.0.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/json-bigint": "^1.0.4",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.lingtu.order-export",
    "productName": "电商平台采购订单导出",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "LingtuOrderExport-${version}-Setup.${ext}",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "电商平台采购订单导出",
      "deleteAppDataOnUninstall": false
    }
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
